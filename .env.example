# Runtime
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_VERSION=1.0.0

# PostgreSQL
# POSTGRES_PASSWORD is used only by compose.production.example.yaml.
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5433/tribal_battle
DB_USERNAME=tribal_battle
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Authentication
AUTH_SESSION_HOURS=168
PASSWORD_RESET_MINUTES=30

# SMTP password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com

# Cloud backup
CLOUD_VERSION_RETENTION=10

# API protection
MAX_REQUEST_BYTES=12582912
TRUST_FORWARDED_FOR=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_15_MINUTES=5
RATE_LIMIT_SHARED_CREATE_PER_MINUTE=60

# API docs
SPRINGDOC_ENABLED=true
